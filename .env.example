# Keep the real key only in the local .env file; never commit it.
OPENCODE_API_KEY=
AUTOSDLC_MODEL=glm-5.3-flash
# Time zone the UI and reports show times in (IANA name); stored times stay UTC.
AUTOSDLC_TIMEZONE=Europe/Istanbul


# Optional: require this shared password in the web UI (empty = open).
APP_PASSWORD=
